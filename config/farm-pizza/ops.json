  "automations": [
    {
      "name": "Chase an abandoned checkout",
      "trigger": "abandoned_basket",
      "days": 0,
      "cooldownDays": 7,
      "promoCode": "COMEBACK15",
      "maxPerRun": 100,
      "body": "{name}, your {shop} order is still sitting in the basket. Finish it with {code} for 15% off - we'll get it in the oven."
    },
    {
      "name": "Win back after 45 days",
      "trigger": "win_back",
      "days": 45,
      "cooldownDays": 60,
      "promoCode": "COMEBACK15",
      "maxPerRun": 200,
      "body": "{shop}: we miss you {name}! {code} gets you 15% off your next order. Order direct at farm-pizza.com"
    },
    {
      "name": "Second order nudge",
      "trigger": "second_order",
      "days": 14,
      "cooldownDays": 45,
      "promoCode": "COMEBACK15",
      "maxPerRun": 150,
      "body": "{name}, hope the first one landed well. {code} for 15% off your next {shop} order."
    },
    {
      "name": "Thank a new customer",
      "trigger": "first_order_thanks",
      "days": 1,
      "cooldownDays": 30,
      "promoCode": "",
      "maxPerRun": 100,
      "body": "Thanks for your first order, {name}. Any problems, call the shop - we'd rather fix it than lose you. {shop}"
    },
    {
      "name": "Quiet night filler",
      "trigger": "quiet_night",
      "days": 30,
      "cooldownDays": 14,
      "promoCode": "FREEDEL",
      "maxPerRun": 250,
      "body": "{name}, kitchen's quiet tonight at {shop}. {code} - free delivery for the next two hours."
    }
  ]
