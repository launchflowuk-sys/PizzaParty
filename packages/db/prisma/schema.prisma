// LaunchFlow takeaway ordering — Prisma schema.
// All money is integer pence. All times UTC; location timezone in Location.timezone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenant ----------

model Client {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  domain            String
  legacyDomains     String[] @default([])
  brandPrimary      String
  brandSecondary    String
  logo              String
  phone             String   @default("")
  email             String   @default("")
  address           String   @default("")
  fulfilment        String[] @default(["delivery", "collection"])
  stripeAccountId   String   @default("")
  cashOnCollection  Boolean  @default(true)
  cashOnDelivery    Boolean  @default(false)
  seoLocality       String[] @default([])
  seoCuisine        String   @default("")
  seoPrimaryKeyword String   @default("")
  kitchenEmail      String   @default("")
  kitchenSms        String   @default("")
  printerWebhook    String   @default("")
  reviewUrl         String   @default("")
  /// Where the owner wants to hear about orders. Deliberately separate from
  /// the public email and phone above - those go on the website, and nobody
  /// wants every order landing in the inbox customers write to.
  ownerEmail        String   @default("")
  ownerSms          String   @default("")
  /// The master switch. One place to silence everything, so a shop having a
  /// bad night is not hunting through thirty toggles.
  notificationsOn   Boolean  @default(true)
  configHash        String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  locations      Location[]
  categories     Category[]
  products       Product[]
  modifierGroups ModifierGroup[]
  deals          Deal[]
  customers      Customer[]
  orders         Order[]
  promos         Promo[]
  stockItems     StockItem[]
  drivers        Driver[]
  staff          Staff[]
  reviews        Review[]
  automations    Automation[]
  notificationRules NotificationRule[]
  pushDevices    PushDevice[]
  marketingSends MarketingSend[]
  smsInbound     SmsInbound[]
  loyaltyRewards LoyaltyReward[]
}

model Location {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  key              String // config id e.g. "basildon"
  name             String
  address          String    @default("")
  phone            String    @default("")
  lat              Float?
  lng              Float?
  timezone         String    @default("Europe/London")
  postcodePrefixes String[]  @default([])
  deliveryFee      Int       @default(0) // pence
  minOrder         Int       @default(0) // pence
  prepMinutes      Int       @default(15)
  deliveryMinutes  Int       @default(35)
  pausedUntil      DateTime?
  pauseReason      String    @default("")
  active           Boolean   @default(true)
  sortOrder        Int       @default(0)

  hours  OpeningHours[]
  orders Order[]
  bands  DeliveryBand[]

  @@unique([clientId, key])
}

/// A delivery charge for part of a shop's area.
///
/// Most takeaways do not charge one flat fee to everywhere they deliver - the
/// far end of the patch costs more to reach and often carries a higher minimum.
/// `Location.deliveryFee` remains the fee for anywhere not covered by a band,
/// so a shop that charges one price everywhere simply has no bands.
model DeliveryBand {
  id           String   @id @default(cuid())
  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// Shown to the customer, e.g. "Grays & Chafford" - never a bare postcode list.
  name         String   @default("")
  /// Districts this band covers. "RM20" matches that district; "RM" matches the
  /// whole area, and loses to a district that names itself.
  prefixes     String[] @default([])
  /// Pence.
  fee          Int      @default(0)
  /// Pence. 0 means fall back to the location's minimum.
  minOrder     Int      @default(0)
  /// Added to the location's delivery time, because further away takes longer.
  extraMinutes Int      @default(0)
  sortOrder    Int      @default(0)

  @@index([locationId])
}

model OpeningHours {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = Sunday ... 6 = Saturday
  opens      String // "16:00"
  closes     String // "23:00" (may be past midnight e.g. "01:00")

  @@index([locationId, dayOfWeek])
}

// ---------- Menu ----------

model Category {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String    @default("")
  image       String    @default("")
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]

  @@unique([clientId, slug])
}

model Product {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String   @default("")
  /// The few appetising lines on the item's own page. Kept apart from
  /// `description`, which is the short ingredient line the cards, the listings
  /// and the search results show - three sentences would wreck those, and the
  /// page needs more than five words to sell anything.
  story       String   @default("")
  image       String   @default("")
  tags        String[] @default([]) // vegetarian, vegan, spicy, new, popular
  allergens   String[] @default([])
  featured    Boolean  @default(false)
  soldOut     Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  ordersCount Int      @default(0)

  sizes          ProductSize[]
  modifierGroups ProductModifierGroup[]
  orderItems     OrderItem[]

  @@unique([clientId, slug])
  @@index([categoryId])
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String // "small" | "medium" | "large" | "regular"
  name      String
  price     Int // pence
  sortOrder Int     @default(0)
  soldOut   Boolean @default(false)

  @@unique([productId, key])
}

model ModifierGroup {
  id        String                 @id @default(cuid())
  clientId  String
  client    Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  key       String
  name      String
  minSelect Int                    @default(0)
  maxSelect Int                    @default(10)
  required  Boolean                @default(false)
  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@unique([clientId, key])
}

model Modifier {
  id        String        @id @default(cuid())
  groupId   String
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  key       String
  name      String
  price     Int           @default(0) // pence, added to line
  sortOrder Int           @default(0)
  soldOut   Boolean       @default(false)

  @@unique([groupId, key])
}

model ProductModifierGroup {
  productId String
  groupId   String
  sortOrder Int           @default(0)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
}

model Deal {
  id          String      @id @default(cuid())
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String      @default("")
  image       String      @default("")
  price       Int // pence, fixed bundle price
  active      Boolean     @default(true)
  featured    Boolean     @default(false)
  sortOrder   Int         @default(0)
  daysOfWeek  Int[]       @default([]) // empty = every day
  fulfilment  String[]    @default([]) // empty = any
  slots       DealSlot[]
  orderItems  OrderItem[]

  @@unique([clientId, slug])
}

/// What a particular item costs extra inside a particular deal line.
///
/// "Any 10 inch pizza" is how a meal deal is sold and it should stay that way -
/// pinning a deal to one pizza makes it a weaker product. But without this every
/// customer rationally picks the most expensive thing the line allows, and the
/// shop carries the difference on every order. A supplement keeps the offer on
/// the poster and stops the leak on the four or five items that genuinely cost
/// more to make.
model DealSlotSupplement {
  id          String   @id @default(cuid())
  slotId      String
  slot        DealSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  /// Matched on the product slug, the same way the slot's own allow-lists work.
  productSlug String
  /// Pence added to the deal price when this item is chosen for this line.
  extra       Int      @default(0)

  @@unique([slotId, productSlug])
}

model DealSlot {
  id               String               @id @default(cuid())
  dealId           String
  deal             Deal                 @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name             String // "Large pizza"
  qty              Int                  @default(1)
  categorySlugs    String[]             @default([]) // allowed categories
  productSlugs     String[]             @default([]) // or explicit products
  sizeKeys         String[]             @default([]) // allowed sizes, empty = any
  extraPerModifier Boolean              @default(true) // modifiers charged on top
  sortOrder        Int                  @default(0)
  supplements      DealSlotSupplement[]
}

// ---------- Customers ----------

model Customer {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phone              String // E.164
  email              String    @default("")
  name               String    @default("")
  guest              Boolean   @default(true)
  marketingOptIn     Boolean   @default(false)
  lastPostcode       String    @default("")
  lastOrderAt        DateTime?
  ordersCount        Int       @default(0)
  totalSpent         Int       @default(0)
  loyaltyPoints      Int       @default(0)
  /// When they asked to stop hearing from us. Kept as evidence: under PECR the
  /// shop has to show it acted on the request, not just that the flag is false.
  optOutAt           DateTime?
  optOutSource       String    @default("")
  /// Nullable rather than "" so the unique index can hold the many customers
  /// who have not been given a code yet.
  referralCode       String?
  referredById       String?
  referralRewardedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  addresses      Address[]
  orders         Order[]
  loyalty        LoyaltyLedger[]
  sessions       Session[]
  otpCodes       OtpCode[]
  marketingSends MarketingSend[]
  smsInbound     SmsInbound[]
  referredBy     Customer?       @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      Customer[]      @relation("Referrals")

  pushDevices        PushDevice[]

  @@unique([clientId, phone])
  @@unique([clientId, referralCode])
  /// Signing in by email looks a customer up by address. Deliberately not
  /// unique: a household shares one, and a unique constraint would make the
  /// second person to order from that address fail at checkout.
  @@index([clientId, email])
  @@index([clientId, lastOrderAt])
  @@index([referredById])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  line1      String
  line2      String   @default("")
  city       String   @default("")
  postcode   String
  notes      String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  orders     Order[]
}

model OtpCode {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

// ---------- Orders ----------

enum OrderStatus {
  pending_payment
  placed
  accepted
  preparing
  ready
  out_for_delivery
  completed
  rejected
  cancelled
}

enum Fulfilment {
  delivery
  collection
}

enum PaymentMethod {
  card
  cash
}

model Order {
  id                  String        @id @default(cuid())
  number              Int           @default(autoincrement())
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  locationId          String
  location            Location      @relation(fields: [locationId], references: [id])
  customerId          String
  customer            Customer      @relation(fields: [customerId], references: [id])
  addressId           String?
  address             Address?      @relation(fields: [addressId], references: [id])
  status              OrderStatus   @default(pending_payment)
  fulfilment          Fulfilment
  paymentMethod       PaymentMethod @default(card)
  customerName        String
  customerPhone       String
  customerEmail       String        @default("")
  deliveryLine1       String        @default("")
  deliveryLine2       String        @default("")
  deliveryCity        String        @default("")
  deliveryPostcode    String        @default("")
  notes               String        @default("")
  scheduledFor        DateTime? // pre-order slot; null = ASAP
  etaMinutes          Int?
  etaAt               DateTime?
  subtotal            Int
  deliveryFee         Int           @default(0)
  discount            Int           @default(0)
  promoCode           String        @default("")
  total               Int
  rejectReason        String        @default("")
  reviewRequestedAt   DateTime?
  /// Set when a recovery message went out for an abandoned checkout, so the
  /// customer is chased once and not every time the cron runs.
  recoveryRequestedAt DateTime?
  placedAt            DateTime?
  acceptedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  items   OrderItem[]
  payment Payment?
  events  OrderEvent[]
  promo   Promo?       @relation(fields: [promoId], references: [id])
  promoId String?

  @@index([clientId, status, createdAt])
  @@index([locationId, status])
  @@index([customerId, createdAt])
}

model OrderItem {
  id         String              @id @default(cuid())
  orderId    String
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?            @relation(fields: [productId], references: [id])
  dealId     String?
  deal       Deal?               @relation(fields: [dealId], references: [id])
  parentId   String? // for deal components: the deal line they belong to
  parent     OrderItem?          @relation("DealComponents", fields: [parentId], references: [id])
  components OrderItem[]         @relation("DealComponents")
  name       String
  sizeKey    String              @default("")
  sizeName   String              @default("")
  qty        Int                 @default(1)
  unitPrice  Int // pence, before modifiers
  lineTotal  Int // pence, (unit + modifiers) * qty ; 0 for deal components
  notes      String              @default("")
  line       Json? // original basket line, used for one-tap reorder
  modifiers  OrderItemModifier[]

  @@index([orderId])
}

model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  groupName   String
  name        String
  price       Int       @default(0)
}

enum PaymentStatus {
  requires_payment
  processing
  succeeded
  failed
  refunded
  cash_pending
  cash_collected
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              String        @default("stripe")
  stripePaymentIntentId String        @default("")
  status                PaymentStatus @default(requires_payment)
  amount                Int
  currency              String        @default("gbp")
  receiptUrl            String        @default("")
  refundedAmount        Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([stripePaymentIntentId])
}

/// Append-only audit log. Kitchen screen and status page read from here.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // created, paid, placed, accepted, preparing, ready, out_for_delivery, completed, rejected, cancelled, note, sms_sent, email_sent, print_sent
  actor     String   @default("system") // system | kitchen | admin | customer | stripe
  message   String   @default("")
  data      Json?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// ---------- Marketing ----------

enum PromoType {
  percent
  fixed
  free_delivery
}

model Promo {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code               String
  type               PromoType
  value              Int       @default(0) // percent (0-100) or pence
  minOrder           Int       @default(0)
  fulfilment         String[]  @default([])
  startsAt           DateTime?
  endsAt             DateTime?
  maxUses            Int?
  uses               Int       @default(0)
  firstOrderOnly     Boolean   @default(false)
  /// Set when this code was minted as a reward for one person, so anyone else
  /// who hears it cannot spend it.
  issuedToCustomerId String    @default("")
  active             Boolean   @default(true)
  orders             Order[]

  @@unique([clientId, code])
}

/// What points can be spent on. Editable by the shop, because "100 points is a
/// free garlic bread" is a pricing decision that changes with the seasons.
model LoyaltyReward {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name       String
  points     Int
  type       PromoType @default(fixed)
  /// pence for a fixed reward, percent for a percentage one, ignored for free delivery
  value      Int       @default(0)
  minOrder   Int       @default(0)
  /// How long the code lives once claimed. Points are spent at that moment, so
  /// this is the window to actually use it.
  expiryDays Int       @default(60)
  active     Boolean   @default(true)
  sortOrder  Int       @default(0)

  @@unique([clientId, name])
}

model LoyaltyLedger {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String   @default("")
  delta      Int
  reason     String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model Campaign {
  id        String   @id @default(cuid())
  clientId  String
  channel   String // sms | email
  segment   String // see lib/segments.ts
  /// Offer code carried by every message, so the campaign's revenue is measured.
  promoCode String   @default("")
  subject   String   @default("")
  body      String
  sent      Int      @default(0)
  failed    Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Back office: stock, drivers, staff and reviews ──────────────────────────
// Added so /admin/inventory, /admin/dispatch, /admin/staff and /admin/reviews
// run on real rows rather than hardcoded markup. Seeded from
// config/<client>/ops.json.

model StockItem {
  id         String   @id @default(cuid())
  clientId   String
  locationId String   @default("")
  name       String
  unit       String   @default("kg")
  onHand     Float    @default(0)
  par        Float    @default(0)
  supplier   String   @default("")
  onOrder    Boolean  @default(false)
  sortOrder  Int      @default(0)
  updatedAt  DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, name])
  @@index([clientId, sortOrder])
}

model Driver {
  id            String    @id @default(cuid())
  clientId      String
  locationId    String    @default("")
  name          String
  phone         String    @default("")
  email         String    @default("")
  vehicle       String    @default("")
  /// available | on_delivery | off
  status        String    @default("available")
  activeOrderId String    @default("")
  backAt        DateTime?
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, name])
  @@index([clientId, status])
}

model Staff {
  id        String  @id @default(cuid())
  clientId  String
  name      String
  /// SHA-256 of "<clientId>:<pin>". Empty means this person cannot sign in yet.
  pinHash   String  @default("")
  /// manager | shift_lead | kitchen | driver | front_of_house
  role      String  @default("kitchen")
  phone     String  @default("")
  email     String  @default("")
  hoursWeek Float   @default(0)
  onShift   Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, name])
  @@index([clientId, role])
}

model Review {
  id           String    @id @default(cuid())
  clientId     String
  orderId      String    @default("")
  customerName String
  rating       Int
  body         String    @default("")
  /// direct | google
  source       String    @default("direct")
  /// Google's own id, so a re-sync updates rather than duplicates. Nullable
  /// rather than "" because it carries a unique index, and Postgres allows many
  /// NULLs but only one "" - which would cap the shop at a single direct review.
  externalId   String?
  authorPhoto  String    @default("")
  /// A link back to the review on Google, for replying where we cannot.
  externalUrl  String    @default("")
  /// Off the storefront. Reviews are never deleted - a shop hiding a bad one
  /// should be a deliberate, reversible act, not a hole in the record.
  hidden       Boolean   @default(false)
  /// Pinned to the front of the storefront strip.
  featured     Boolean   @default(false)
  reply        String    @default("")
  repliedAt    DateTime?
  /// When Google says it was written, which is not when we first saw it.
  postedAt     DateTime?
  createdAt    DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, externalId])
  @@index([clientId, createdAt])
  @@index([clientId, hidden, rating])
}

// ─── Marketing: lifecycle automations and attribution ────────────────────────
// The shop owns its customers, so it can market to them directly instead of
// renting them back from an aggregator. Automations run on a schedule and send
// once per customer per window; every send carries a promo code, and redemptions
// of that code are attributed back to the send that caused them.

model Automation {
  id           String    @id @default(cuid())
  clientId     String
  name         String
  /// win_back | second_order | birthday | quiet_night | first_order_thanks
  trigger      String
  /// sms | email
  channel      String    @default("sms")
  /// Trigger parameter, e.g. days since last order.
  days         Int       @default(30)
  /// Promo code attached to every send, so revenue can be attributed.
  promoCode    String    @default("")
  body         String
  subject      String    @default("")
  active       Boolean   @default(false)
  /// Never contact the same customer more than once inside this many days.
  cooldownDays Int       @default(30)
  /// Safety rail: refuse to send more than this in one run.
  maxPerRun    Int       @default(200)
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sends  MarketingSend[]

  @@unique([clientId, name])
  @@index([clientId, active])
}

model MarketingSend {
  id              String    @id @default(cuid())
  clientId        String
  automationId    String?
  campaignId      String?
  customerId      String
  channel         String
  /// automation | campaign | basket_recovery | review_request | referral_reward.
  /// Everything the shop pays to send lands in this table, so spend and the
  /// shared contact cooldown cover all of it rather than campaigns alone.
  kind            String    @default("automation")
  promoCode       String    @default("")
  /// Cost in pence, so a campaign's spend can be set against its revenue.
  costPence       Int       @default(0)
  status          String    @default("sent")
  error           String    @default("")
  /// Set when an order redeems this send's code.
  redeemedOrderId String    @default("")
  redeemedAt      DateTime?
  revenuePence    Int       @default(0)
  sentAt          DateTime  @default(now())

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([clientId, sentAt])
  @@index([customerId, sentAt])
  @@index([automationId, sentAt])
  @@index([clientId, promoCode])
}

/// Replies to the shop's own number. Only opt-out keywords are acted on; the
/// rest is kept so someone can see what was said rather than it vanishing.
model SmsInbound {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  fromPhone  String
  body       String
  /// stop | start | "" when it was neither
  keyword    String    @default("")
  providerId String    @default("")
  receivedAt DateTime  @default(now())

  @@index([clientId, receivedAt])
}

/// One switch per (event, who hears it, how).
///
/// Texts cost money per message and email costs nothing, so a shop that sends
/// everything by SMS runs out of credit in a week. Every notification therefore
/// exists on both channels and each one can be turned off on its own - the
/// normal setup is email for everything and SMS only where somebody genuinely
/// needs to look at their phone.
///
/// A missing row means off. Defaults are seeded in packages/db/src/notifications.ts
/// so a new shop starts sensible rather than silent.
model NotificationRule {
  id           String  @id @default(cuid())
  clientId     String
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// order_placed | order_accepted | order_preparing | order_ready |
  /// order_out_for_delivery | order_completed | order_rejected |
  /// order_refunded | review_request
  event        String
  /// customer | kitchen | admin | driver
  audience     String
  /// email | sms
  channel      String
  enabled      Boolean @default(false)
  /// Minutes to wait before sending. Only the review request uses this today.
  delayMinutes Int     @default(0)

  @@unique([clientId, event, audience, channel])
  @@index([clientId, event])
}

/// A phone that has agreed to receive notifications.
///
/// Registered without a customer on purpose: a guest who has not signed in
/// still ordered food and still wants to know when it is on its way, so the
/// device is recorded first and attached to a customer when they log in.
///
/// `disabledAt` is set when Expo reports DeviceNotRegistered - the app was
/// deleted, or permission was withdrawn. The row is kept rather than deleted
/// so the same token is not endlessly retried.
model PushDevice {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Expo push token. The natural key - one row per device, whoever is signed in.
  token      String    @unique
  platform   String    @default("")
  deviceId   String    @default("")
  appVersion String    @default("")
  lastSeenAt DateTime  @default(now())
  disabledAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([clientId, customerId])
}
