# Which client config to load from /config/<slug>
CLIENT_SLUG=farm-pizza
# Public base URL (used for canonical, sitemap, OG, SMS links)
NEXT_PUBLIC_SITE_URL=https://farm-pizza.com

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farm_pizza

# Stripe (platform keys; per-client connected account id lives in client.json)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Email
# Email over plain SMTP - the shop's own mailbox, or any provider. No vendor
# SDK, so moving hosts is these five lines and nothing else.
# Port 465 = implicit TLS, 587 = STARTTLS. SMTP_SECURE follows the port unless set.
SMTP_HOST=smtp.your-host.co.uk
SMTP_PORT=587
SMTP_USER=orders@farm-pizza.shop
SMTP_PASS=
MAIL_FROM="Farm Pizza <orders@farm-pizza.shop>"

# SMS
TWILIO_ACCOUNT_SID=ACxxx
# Also verifies the inbound webhook at /api/sms/inbound. Without it that
# endpoint refuses every request, so "Reply STOP" stops working - set it even
# if you are not sending yet.
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM=+441234567890

# Google reviews (optional).
# A Places API key from a Google Cloud project with the Places API (New) enabled.
# The shop's Place ID goes in config/<slug>/client.json under contact.googlePlaceId.
# Leave either blank and the Google review features stay switched off — reviews
# left through this site still work.
# Note: Google returns FIVE reviews, and the API cannot post replies.
GOOGLE_PLACES_API_KEY=

# Ops auth.
# These are the only way into the back office, so generate real values before
# the stack is reachable from anywhere but your own machine - a quick tunnel
# counts as "anywhere". Generate each with:
#   node -e "console.log(require('crypto').randomBytes(21).toString('base64url'))"
# Leaving ADMIN_PASSWORD or LAUNCHFLOW_KEY empty disables that route entirely,
# which is safe; an empty SESSION_SECRET is fatal in production on purpose.
KITCHEN_PIN=1234
ADMIN_PASSWORD=
LAUNCHFLOW_KEY=
SESSION_SECRET=
CRON_SECRET=
