# Which client config to load from /config/<slug>
CLIENT_SLUG=farm-pizza
# Public base URL (used for canonical, sitemap, OG, SMS links)
NEXT_PUBLIC_SITE_URL=https://farm-pizza.com

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farm_pizza

# Stripe (platform keys; per-client connected account id lives in client.json)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Email
# Email over plain SMTP - the shop's own mailbox, or any provider. No vendor
# SDK, so moving hosts is these five lines and nothing else.
# Port 465 = implicit TLS, 587 = STARTTLS. SMTP_SECURE follows the port unless set.
SMTP_HOST=smtp.your-host.co.uk
SMTP_PORT=587
SMTP_USER=orders@farm-pizza.shop
SMTP_PASS=
MAIL_FROM="Farm Pizza <orders@farm-pizza.shop>"

# SMS
TWILIO_ACCOUNT_SID=ACxxx
# Also verifies the inbound webhook at /api/sms/inbound. Without it that
# endpoint refuses every request, so "Reply STOP" stops working - set it even
# if you are not sending yet.
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM=+441234567890

# Google reviews (optional).
# A Places API key from a Google Cloud project with the Places API (New) enabled.
# The shop's Place ID goes in config/<slug>/client.json under contact.googlePlaceId.
# Leave either blank and the Google review features stay switched off — reviews
# left through this site still work.
# Note: Google returns FIVE reviews, and the API cannot post replies.
GOOGLE_PLACES_API_KEY=

# Ops auth.
# These are the only way into the back office, so generate real values before
# the stack is reachable from anywhere but your own machine - a quick tunnel
# counts as "anywhere". Generate each with:
#   node -e "console.log(require('crypto').randomBytes(21).toString('base64url'))"
# Leaving ADMIN_PASSWORD or LAUNCHFLOW_KEY empty disables that route entirely,
# which is safe; an empty SESSION_SECRET is fatal in production on purpose.
KITCHEN_PIN=1234
ADMIN_PASSWORD=
LAUNCHFLOW_KEY=
SESSION_SECRET=
CRON_SECRET=

# ---------------------------------------------------------------------------
# Till: caller ID (POS item 28). Optional - empty CALLERID_TOKEN switches the
# webhook off (404). Generate a long random token (same command as above) and
# give the phone provider:  POST https://<site>/api/pos/callerid?token=<CALLERID_TOKEN>
#   Twilio: set it as the number's "Call status changes" callback, so calls keep
#   ringing exactly as they do now; signatures are checked with TWILIO_AUTH_TOKEN.
#   Other VoIP/SIP: POST JSON {"phone":"07...","line":"Shop"} to the same URL.
# CALLERID_FORWARD_TO: only if this URL is used as Twilio's "A call comes in"
# webhook - then the reply puts every call through to this number (the shop phone).
CALLERID_TOKEN=
CALLERID_FORWARD_TO=

# ---------------------------------------------------------------------------
# Just Eat / Deliveroo / Uber Eats via Deliverect (POS item 31). Optional.
# DELIVERECT_SECRET switches it on: orders arrive at
#   POST https://<site>/api/integrations/deliverect/orders  (HMAC-signed by Deliverect;
#   on their staging environment the secret is the channel link id)
# and the menu (our PLUs) is at
#   GET  https://<site>/api/integrations/deliverect/menu   (Authorization: Bearer <DELIVERECT_MENU_TOKEN>)
# The menu export has its own token so the order-signing secret never sits in a URL.
DELIVERECT_SECRET=
DELIVERECT_MENU_TOKEN=
# Status push-back (accepted / ready / completed / rejected -> the marketplace).
# From Deliverect when the POS integration is approved. Staging base:
# https://api.staging.deliverect.com , production: https://api.deliverect.com
DELIVERECT_API_BASE=
DELIVERECT_CLIENT_ID=
DELIVERECT_CLIENT_SECRET=
# OAuth audience; blank = DELIVERECT_API_BASE.
DELIVERECT_AUDIENCE=
# Deliverect channel number = our source. Confirm the numbers with Deliverect;
# blank = 2=deliveroo,7=ubereats,10=justeat (only Deliveroo's 2 is documented).
DELIVERECT_CHANNELS=
# Orders from an unknown channel are still taken, filed under this source and flagged.
DELIVERECT_DEFAULT_SOURCE=deliveroo
# Deliverect location id = our location key, comma separated; blank = first location.
DELIVERECT_LOCATIONS=
# Echoed into the menu export so it can be uploaded as-is.
DELIVERECT_ACCOUNT_ID=
DELIVERECT_LOCATION_ID=
